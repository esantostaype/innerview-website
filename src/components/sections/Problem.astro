---
import { Image } from 'astro:assets';
import paperwork from '../../assets/photos/paperwork.jpg';
import { documentModes } from '../../data/content';

const phrases = [
  'Every month-end starts the same way.',
  'Invoices arrive as PDFs, scans, spreadsheets and phone photos.',
  'Someone retypes each line,',
  'looks up the GL account, the property and the unit,',
  'and hopes the ResMan import doesn’t fail.',
];
---

<section class="relative py-[var(--spacing-section)]" aria-labelledby="problem-title">
  <div class="container-site">
    <h2 id="problem-title" class="sr-only">The month-end problem</h2>

    <div class="grid gap-12 lg:grid-cols-12">
      <p
        class="problem-copy text-h2 leading-[1.2] font-[350] lg:col-span-10"
        data-scroll
        data-scroll-css-progress
        data-scroll-offset="10%,55%"
        style={`--count:${phrases.length}`}
      >
        {
          phrases.map((p, i) => (
            <>
              <span class="phrase" style={`--i:${i}`}>
                {p}
              </span>{' '}
            </>
          ))
        }
      </p>
    </div>

    <div class="mt-20 grid gap-10 md:mt-28 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7 lg:pt-10">
        <p class="max-w-md text-body text-muted" data-scroll data-reveal>
          InnerView accepts the formats your vendors actually send. It reads each one, and the batch can mix them.
        </p>
        <ul class="mt-10 border-t border-rule" aria-label="Document modes InnerView reads">
          {
            documentModes.map((mode, i) => (
              <li
                class="border-b border-rule py-4 md:py-5"
                data-scroll
                data-reveal
                style={`--reveal-delay:${i * 70}`}
              >
                <span class="text-h3 font-[400] text-fg">{mode}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="relative lg:col-span-4 lg:col-start-9">
        <div class="overflow-hidden rounded-[var(--radius-frame)]" data-scroll data-reveal="rise-clip">
          <div data-scroll data-scroll-speed="-0.06" class="scale-110">
            <Image
              src={paperwork}
              alt="Vendor paperwork, a calculator and a pen spread across a dark desk."
              quality={62}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 30vw, 100vw"
              class="aspect-[4/5] w-full object-cover grayscale-[35%]"
            />
          </div>
        </div>
        <figcaption class="mt-3 text-caption text-subtle">The paper trail AP teams retype every close.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .phrase {
    color: var(--fg);
  }

  :global(html.motion-ready) .phrase {
    /* each phrase lights up as the paragraph crosses the viewport */
    --lit: clamp(0, calc(var(--progress, 0) * (var(--count) + 1) - var(--i)), 1);
    color: color-mix(in oklab, var(--fg) calc(var(--lit) * 100%), var(--rule-strong));
    transition: color 300ms linear;
  }
</style>
