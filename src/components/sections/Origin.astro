---
import { Image } from 'astro:assets';
import balconies from '../../assets/photos/balconies.jpg';
import SplitHeading from '../ui/SplitHeading.astro';
---

<section class="relative isolate overflow-hidden bg-ink text-ink-fg" aria-labelledby="origin-title">
  <div class="absolute inset-0 -z-10" data-scroll data-scroll-speed="-0.12">
    <Image
      src={balconies}
      alt=""
      quality={62}
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      class="h-[125%] w-full object-cover object-[50%_30%] opacity-70 dark:opacity-55"
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(7_12_20/0.15)_0%,rgb(7_12_20/0.35)_45%,rgb(7_12_20/0.88)_100%)]"></div>

  <div class="container-site flex min-h-[92svh] flex-col justify-end pt-40 pb-16 md:min-h-[110svh] md:pb-24">
    <SplitHeading
      id="origin-title"
      lines={['Built inside a multifamily', 'property management team.']}
      class="max-w-5xl text-h1 font-[350] text-white"
    />
    <p class="mt-8 max-w-xl text-lead text-white/80" data-scroll data-reveal style="--reveal-delay:200">
      InnerView started in the AP department that lives the month-end close. It speaks in vendors, doors, GL accounts and
      ResMan imports, because that is the job.
    </p>
  </div>
</section>
