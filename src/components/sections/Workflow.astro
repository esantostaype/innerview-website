---
import SplitHeading from '../ui/SplitHeading.astro';
import Icon from '../ui/Icon.astro';
import { Mail01Icon, File02Icon, Tick02Icon } from '@hugeicons/core-free-icons';
import { workflow, stages, cellSources } from '../../data/content';

/**
 * Reconstruction of the AP flow, built from the product's real labels:
 * AP Inbox (APInboxWorkspace.tsx), processing stages (engine/progress.ts),
 * cell provenance (Extracted / Derived) and the ResMan import export.
 * Row values are sample data from the demo workspace (overviewMock.ts).
 */
const stepOfStage = (stage: string) => workflow.findIndex((w) => (w.stages as readonly string[]).includes(stage));

const columns = [
  { key: 'vendor', label: 'Vendor', value: 'Summit HVAC Services', source: cellSources[0], step: 1 },
  { key: 'invoice', label: 'Invoice Number', value: 'SH-20931', source: cellSources[0], step: 1 },
  { key: 'property', label: 'Property', value: 'Willow Creek Village', source: cellSources[1], step: 2 },
  { key: 'gl', label: 'GL Account', value: 'HVAC repairs', source: cellSources[1], step: 2 },
  { key: 'amount', label: 'Amount', value: '$1,284.00', source: cellSources[0], step: 2 },
];
---

<section id="how-it-works" class="relative scroll-mt-20 border-t border-rule py-[var(--spacing-section)]" aria-labelledby="workflow-title">
  <div class="container-site">
    <div class="grid gap-8 lg:grid-cols-12">
      <SplitHeading
        id="workflow-title"
        lines={['From the AP inbox', 'to the import file.']}
        class="text-h1 font-[350] lg:col-span-8"
      />
      <p class="max-w-sm text-body text-muted lg:col-span-4 lg:self-end" data-scroll data-reveal>
        One batch, eleven stages, no retyping. Every step below is a screen your team already has in InnerView.
      </p>
    </div>

    <div class="mt-16 grid gap-10 md:mt-24 lg:grid-cols-12 lg:gap-8" data-workflow data-active-step="0">
      <!-- Sticky reconstruction -->
      <div class="min-w-0 lg:col-span-6 lg:col-start-1">
        <div class="lg:sticky lg:top-24" aria-hidden="true">
          <div class="flow-panel product-frame">
            <!-- Inbox row -->
            <div class="flex items-center gap-4 border-b border-rule px-6 py-5">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sunken text-muted">
                <Icon icon={Mail01Icon} size={18} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-small text-fg">Summit HVAC Services · Invoice SH-20931</p>
                <p class="text-caption text-subtle">Outlook · 1 document · 2 pages</p>
              </div>
              <span class="status-pill numerals rounded-full px-2.5 py-1 text-caption font-medium">
                <span data-status="0">new</span>
                <span data-status="1">in batch</span>
                <span data-status="2">in batch</span>
                <span data-status="3">processed</span>
              </span>
            </div>

            <!-- Stages -->
            <ol class="grid grid-cols-2 gap-x-6 px-6 py-5 text-caption sm:grid-cols-3">
              {
                stages.map((stage) => (
                  <li class="stage flex items-center gap-2 py-1.5" data-for-step={stepOfStage(stage)}>
                    <span class="stage-dot size-1.5 shrink-0 rounded-full" />
                    <span class="truncate">{stage}</span>
                  </li>
                ))
              }
            </ol>

            <!-- Import row -->
            <div class="border-t border-rule bg-sunken/60 px-6 py-5">
              <div class="flex items-center justify-between text-caption text-subtle">
                <span class="flex items-center gap-2">
                  <Icon icon={File02Icon} size={14} />
                  Batch-0412_ResMan_Import.xlsx
                </span>
                <span class="export-ready flex items-center gap-1 text-ready">
                  <Icon icon={Tick02Icon} size={14} />
                  Ready
                </span>
              </div>
              <dl class="mt-4 grid grid-cols-2 border-t border-l border-rule sm:grid-cols-[1.25fr_1fr_1.25fr_1fr_0.9fr]">
                {
                  columns.map((c, i) => (
                    <div
                      class:list={['cell border-r border-b border-rule px-3 py-3', i === columns.length - 1 && 'col-span-2 sm:col-span-1']}
                      data-fill-step={c.step}
                    >
                      <dt class="text-[0.6875rem] text-subtle">{c.label}</dt>
                      <dd class="mt-1 text-label leading-snug text-balance text-fg numerals">
                        <span class="cell-value">{c.value}</span>
                      </dd>
                      <dd class="cell-source mt-1 text-[0.6875rem] text-primary">{c.source}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
          <p class="mt-4 text-caption text-subtle">Reconstructed from InnerView’s AP screens · sample data</p>
        </div>
      </div>

      <!-- Steps -->
      <ol class="min-w-0 lg:col-span-5 lg:col-start-8">
        {
          workflow.map((step, i) => (
            <li
              data-step={i}
              class="step flex min-h-0 flex-col justify-center border-t border-rule py-12 lg:min-h-[78vh] lg:border-t-0 lg:py-0"
            >
              <p class="numerals text-label text-subtle">
                Step {i + 1} of {workflow.length}
              </p>
              <h3 class="step-title mt-4 text-h2 font-[350]">{step.title}</h3>
              <p class="mt-5 max-w-md text-body text-muted">{step.body}</p>
              <ul class="mt-7 flex flex-wrap gap-2" aria-label="Labels in the product">
                {step.terms.map((t) => (
                  <li class="rounded-full px-3 py-1 text-caption text-muted shadow-[inset_0_0_0_1px_var(--rule)]">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .flow-panel {
    background: var(--bg-raised);
  }

  /* Status pill */
  .status-pill {
    display: inline-grid;
    background: var(--bg-sunken);
    color: var(--fg-muted);
    transition: background-color 400ms, color 400ms;
  }
  .status-pill > span {
    grid-area: 1 / 1;
    text-align: center;
    opacity: 0;
    transition: opacity 300ms;
  }
  [data-active-step='0'] .status-pill [data-status='0'],
  [data-active-step='1'] .status-pill [data-status='1'],
  [data-active-step='2'] .status-pill [data-status='2'],
  [data-active-step='3'] .status-pill [data-status='3'] {
    opacity: 1;
  }
  [data-active-step='3'] .status-pill {
    background: color-mix(in oklab, var(--state-ready) 14%, transparent);
    color: var(--state-ready);
  }

  /* Stages light up as their step is reached */
  .stage {
    color: var(--fg-subtle);
    transition: color 400ms;
  }
  .stage-dot {
    background: var(--rule-strong);
    transition: background-color 400ms, box-shadow 400ms;
  }
  [data-active-step='0'] .stage[data-for-step='0'],
  [data-active-step='1'] .stage[data-for-step='1'],
  [data-active-step='2'] .stage[data-for-step='2'],
  [data-active-step='3'] .stage[data-for-step='3'] {
    color: var(--fg);
  }
  [data-active-step='0'] .stage[data-for-step='0'] .stage-dot,
  [data-active-step='1'] .stage[data-for-step='1'] .stage-dot,
  [data-active-step='2'] .stage[data-for-step='2'] .stage-dot,
  [data-active-step='3'] .stage[data-for-step='3'] .stage-dot {
    background: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent);
  }
  [data-active-step='1'] .stage[data-for-step='0'] .stage-dot,
  [data-active-step='2'] .stage:is([data-for-step='0'], [data-for-step='1']) .stage-dot,
  [data-active-step='3'] .stage:not([data-for-step='3']) .stage-dot {
    background: var(--fg-muted);
  }

  /* Cells fill once their step is reached */
  .cell-value,
  .cell-source {
    display: inline-block;
    opacity: 0.12;
    filter: blur(3px);
    transition:
      opacity 600ms var(--ease-out-expo),
      filter 600ms var(--ease-out-expo);
  }
  [data-active-step='1'] .cell[data-fill-step='1'] :is(.cell-value, .cell-source),
  [data-active-step='2'] .cell:is([data-fill-step='1'], [data-fill-step='2']) :is(.cell-value, .cell-source),
  [data-active-step='3'] .cell :is(.cell-value, .cell-source) {
    opacity: 1;
    filter: none;
  }

  .export-ready {
    opacity: 0;
    transition: opacity 500ms;
  }
  [data-active-step='3'] .export-ready {
    opacity: 1;
  }

  /* Steps: the current one reads strongest */
  @media (min-width: 1024px) {
    :global(html.motion-ready) .step .step-title {
      color: var(--fg-subtle);
      transition: color 600ms var(--ease-out-expo);
    }
    :global(html.motion-ready) .step[data-current] .step-title {
      color: var(--fg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell-value,
    .cell-source {
      filter: none;
    }
  }
</style>
