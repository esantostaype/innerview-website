---
import Logo from './ui/Logo.astro';
import ThemeSwitcher from './ui/ThemeSwitcher.astro';
import { nav, site } from '../data/content';

const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
  <div class="container-site grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Logo height={22} id="footer-logo" class="text-fg" />
      <p class="mt-6 max-w-sm text-small text-muted">
        The accounting and finance platform for multifamily real estate.
      </p>
    </div>

    <nav aria-label="Footer" class="md:col-span-4">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-3 text-small">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-muted transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/#demo" class="text-muted transition-colors hover:text-fg">Book a demo</a>
        </li>
      </ul>
    </nav>

    <div class="flex items-start md:col-span-3 md:justify-end">
      <ThemeSwitcher />
    </div>
  </div>

  <div class="container-site flex flex-col gap-2 border-t border-rule py-6 text-caption text-subtle sm:flex-row sm:justify-between">
    <p>© {year} {site.name}. Developed by {site.developer}.</p>
    <p>Product screens use a demo workspace with sample data.</p>
  </div>
</footer>
