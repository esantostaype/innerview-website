---
/**
 * Planning › Budgets, FY 2027, Riverbend Flats. Methods and figures are coherent:
 * loss to lease = 2.2% of market rent; payroll = Sep × 1.03; loan interest by days (Actual/360).
 */
import Icon from '../ui/Icon.astro';
import { ArrowDown01Icon, Building03Icon, Clock01Icon, GitCompareIcon, Download04Icon, Tick02Icon } from '@hugeicons/core-free-icons';

type Row = { gl: string; name: string; method: string; sep: string; f: string[]; id?: string };
const rows: Row[] = [
  { gl: '4111', name: 'Market rent', method: 'Rent model · lease by lease', sep: '452,160', f: ['461,200', '461,900', '463,400', '465,100'], id: 'rent' },
  { gl: '4120', name: 'Loss to lease', method: 'Formula · 2.2% of 4111', sep: '(9,840)', f: ['(10,146)', '(10,162)', '(10,195)', '(10,232)'], id: 'ltl' },
  { gl: '4210', name: 'Vacancy loss', method: 'Rent model', sep: '(27,130)', f: ['(25,830)', '(24,960)', '(24,310)', '(23,720)'] },
  { gl: '5110', name: 'Payroll · site', method: 'Percentage growth · 3.0%', sep: '61,250', f: ['63,088', '63,088', '63,088', '63,088'] },
  { gl: '6510', name: 'Electricity', method: 'Same as last year', sep: '18,241', f: ['17,920', '16,480', '15,210', '13,940'], id: 'elec' },
  { gl: '6420', name: 'HVAC repairs', method: 'Use average · 12 mo', sep: '4,100', f: ['4,183', '4,183', '4,183', '4,183'] },
  { gl: '7110', name: 'Mortgage interest', method: 'Contract · Actual/360', sep: '89,432', f: ['92,413', '83,470', '92,413', '89,432'] },
];
const months = ['Jan 27', 'Feb 27', 'Mar 27', 'Apr 27'];
---

<div class="ui ui-plan" data-ui="plan" aria-hidden="true">
  <div class="ui-bar">
    <span class="ui-title">Budget · FY 2027</span>
    <span class="ui-chip"><Icon icon={Building03Icon} size={12} />Riverbend Flats<Icon icon={ArrowDown01Icon} size={11} /></span>
    <span class="ui-chip is-solid">Draft</span>
    <span class="ui-muted flex items-center gap-1 text-[11px]"><Icon icon={Clock01Icon} size={12} />Saved 2 min ago</span>
    <span class="ml-auto flex items-center gap-2">
      <span class="flex">
        <span class="ui-avatar" style="background:linear-gradient(135deg,#7a5af5,#b48cff)">SN</span>
        <span class="ui-avatar -ml-1.5" style="background:linear-gradient(135deg,#2f6fb0,#4fb3d9)">ML</span>
      </span>
      <span class="ui-chip"><Icon icon={GitCompareIcon} size={12} />Compare forecasts</span>
      <span class="ui-chip is-primary"><Icon icon={Download04Icon} size={12} />Export</span>
    </span>
  </div>

  <div class="bg">
    <p class="bg-row bg-th">
      <span>Account</span><span>Method</span><span class="ui-num">Sep 26 · A</span>
      {months.map((m) => <span class="ui-num">{m}</span>)}
    </p>
    {
      rows.map((r) => (
        <p class="bg-row" data-bg-row={r.id}>
          <span class="bg-acct">
            <span class="ui-muted">{r.gl}</span> {r.name}
          </span>
          <span class="bg-method">{r.method}</span>
          <span class="ui-num ui-muted">{r.sep}</span>
          {r.f.map((v, i) => (
            <span class="ui-num bg-cell" data-bg-cell={`${r.id ?? r.gl}-${i}`}>
              <span class="bg-val">{v}</span>
            </span>
          ))}
        </p>
      ))
    }
  </div>

  <div class="bg-status">
    <span class="flex items-center gap-1.5"><span class="ui-up"><Icon icon={Tick02Icon} size={13} /></span>Complete · 7 of 11 accounts</span>
    <span class="ui-muted">Sum of selection · $461,200.00</span>
  </div>

  <!-- Trace: where a number comes from -->
  <svg class="bg-trace" data-bg-trace viewBox="0 0 720 400" preserveAspectRatio="none">
    <path data-bg-trace-path d="M0 0"></path>
  </svg>
  <div class="ui-pop bg-eq" data-bg-eq>
    <span class="ui-muted">Trace</span>
    <span>= <b>4111</b> Market rent × −2.2%</span>
  </div>

  <!-- Compare forecasts -->
  <div class="ui-pop bg-compare" data-bg-compare>
    <p class="ui-title">Compare forecasts · 6510 Electricity</p>
    <p class="ui-muted bg-compare-sub">Jan–Apr 2027 total</p>
    <p class="bg-opt is-current"><i class="dot a"></i>Same as last year<span class="ui-num">$63,550</span><em>current</em></p>
    <p class="bg-opt" data-bg-opt><i class="dot b"></i>Seasonal · Holt-Winters<span class="ui-num">$62,980</span><em class="ui-up">−570</em></p>
    <p class="bg-opt"><i class="dot c"></i>Use average · 12 mo<span class="ui-num">$68,420</span><em class="ui-down">+4,870</em></p>
    <p class="ui-muted bg-compare-note">More complexity does not guarantee a better forecast.</p>
  </div>
</div>

<style>
  .ui-plan {
    width: 760px;
  }
  .bg {
    padding: 6px 8px 4px;
  }
  .bg-row {
    display: grid;
    grid-template-columns: 150px 170px 74px repeat(4, 1fr);
    gap: 6px;
    align-items: center;
    padding: 0 8px;
    height: 38px;
    border-bottom: 1px solid var(--ui-line);
  }
  .bg-th {
    height: 32px;
    font-size: 11px;
    color: var(--ui-muted);
  }
  .bg-acct {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bg-method {
    justify-self: start;
    max-width: 100%;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--primary);
    background: color-mix(in oklab, var(--primary) 8%, transparent);
  }
  .bg-cell {
    position: relative;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 6px;
    border-radius: 5px;
    transition:
      background-color 300ms,
      box-shadow 300ms;
  }
  .bg-cell.is-source {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 60%, transparent);
  }
  .bg-cell.is-target {
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--primary);
  }
  .bg-row.is-focus {
    background: color-mix(in oklab, var(--primary) 5%, transparent);
  }
  .bg-status {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px 12px;
    font-size: 11px;
  }
  .bg-trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .bg-trace path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
  .bg-eq {
    display: flex;
    gap: 8px;
    padding: 7px 10px;
    font-size: 11.5px;
    opacity: 0;
  }
  .bg-eq b {
    font-weight: 600;
  }
  .bg-compare {
    right: 18px;
    top: 160px;
    width: 300px;
    padding: 12px 14px;
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transform-origin: 80% 0%;
  }
  .bg-compare-sub {
    font-size: 11px;
    margin-bottom: 6px !important;
  }
  .bg-opt {
    display: grid;
    grid-template-columns: 12px 1fr auto 52px;
    gap: 8px;
    align-items: center;
    padding: 6px 8px;
    margin: 0 -8px;
    border-radius: 6px;
    transition: background-color 250ms;
  }
  .bg-opt em {
    font-style: normal;
    font-size: 11px;
    text-align: right;
    color: var(--ui-muted);
  }
  .bg-opt.is-current {
    background: var(--bg-sunken);
  }
  .bg-opt.is-picked {
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--primary) 35%, transparent);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 99px;
  }
  .dot.a {
    background: var(--primary);
  }
  .dot.b {
    background: var(--accent);
  }
  .dot.c {
    background: var(--ui-muted);
  }
  .bg-compare-note {
    margin-top: 8px !important;
    padding-top: 8px;
    border-top: 1px solid var(--ui-line);
    font-size: 11px;
  }
</style>
