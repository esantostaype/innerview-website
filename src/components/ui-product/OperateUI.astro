---
/**
 * AP Operations › Batches › invoice review. Stage names are the product's (engine/progress.ts).
 * The bill reconciles: 16,904.12 + 86.00 + 1,250.43 = 18,240.55.
 */
import Icon from '../ui/Icon.astro';
import { Pdf01Icon, CheckmarkCircle02Icon, Alert02Icon, Clock01Icon, SparklesIcon } from '@hugeicons/core-free-icons';
import { stages } from '../../data/content';

const lines = [
  { d: 'Electric service · 214,880 kWh', amt: '16,904.12' },
  { d: 'Customer charge', amt: '86.00' },
  { d: 'Fuel cost adjustment', amt: '1,250.43' },
];
const others = [
  { v: 'Summit HVAC Services', n: 'SH-20931', amt: '1,284.00', s: 'review', l: 'Needs review' },
  { v: 'GreenScape Landscaping', n: 'GS-7712', amt: '2,950.00', s: 'ready', l: 'Ready' },
  { v: 'Riverstone Water Utility', n: 'RW-30418', amt: '15,676.45', s: 'blocked', l: 'Property mismatch' },
];
---

<div class="ui ui-operate" data-ui="operate" aria-hidden="true">
  <div class="ui-bar">
    <span class="ui-title">Batch Sep-W4</span>
    <span class="ui-muted">42 invoices · 7 vendors · 5 properties</span>
    <span class="ml-auto flex items-center gap-2">
      <span class="ui-chip"><Icon icon={SparklesIcon} size={12} />Accounting assistant</span>
      <span class="ui-chip is-primary">Export</span>
    </span>
  </div>

  <!-- Processing stages -->
  <div class="op-stages">
    <div class="op-stage-track">
      {stages.map((_, i) => <i data-op-seg={i} />)}
    </div>
    <p class="op-stage-label">
      <span class="ui-muted" data-op-count>Stage 1 of {stages.length}</span>
      <span data-op-stage>{stages[0]}</span>
    </p>
  </div>

  <div class="op-body">
    <!-- Source document -->
    <div class="op-doc">
      <p class="op-doc-file"><Icon icon={Pdf01Icon} size={13} />0925-118344.pdf · page 1 of 2</p>
      <div class="op-paper">
        <p class="op-vendor">Cumberland Power &amp; Light</p>
        <p class="op-small">Commercial electric statement</p>
        <div class="op-fields">
          <p><span>Account</span><b data-op-field="acct">0925-118344</b></p>
          <p><span>Service address</span><b data-op-field="addr">4100 Riverbend Pkwy, Bldg 3<br />Nashville, TN 37209</b></p>
          <p><span>Billing period</span><b>Aug 22 – Sep 21, 2026</b></p>
          <p><span>Due date</span><b>Oct 21, 2026</b></p>
        </div>
        <div class="op-charges" data-op-field="charges">
          {lines.map((l) => <p><span>{l.d}</span><span>{l.amt}</span></p>)}
        </div>
        <p class="op-due" data-op-field="total"><span>Amount due</span><b>$18,240.55</b></p>
      </div>
    </div>

    <!-- Coded lines -->
    <div class="op-lines">
      <p class="op-section">Coded lines · Cumberland Power &amp; Light</p>
      <div class="op-table">
        <p class="op-tr op-th"><span>Description</span><span>Property · unit</span><span>GL account</span><span class="ui-num">Amount</span></p>
        {
          lines.map((l, i) => (
            <p class="op-tr" data-op-line={i}>
              <span class="op-desc">{l.d}</span>
              <span class="op-fill">
                Riverbend Flats<em class="ui-muted">Bldg 3 · common</em>
              </span>
              <span class="op-fill">
                6510 Electricity<em class="op-src">Derived</em>
              </span>
              <span class="op-fill ui-num">
                {l.amt}
                <em class="op-src">Extracted</em>
              </span>
            </p>
          ))
        }
      </div>
      <div class="op-ready" data-op-ready>
        <span class="op-ready-pending"><Icon icon={Clock01Icon} size={14} />Checking readiness…</span>
        <span class="op-ready-done"><Icon icon={CheckmarkCircle02Icon} size={14} />Invoice ready to export. Totals reconcile to $18,240.55</span>
      </div>

      <p class="op-section mt-4">Rest of the batch</p>
      {
        others.map((o) => (
          <p class="op-other">
            <span>
              {o.v} <span class="ui-muted">· {o.n}</span>
            </span>
            <span class="ui-num">{o.amt}</span>
            <span class:list={['ui-chip', `is-${o.s}`]}>
              {o.s === 'ready' && <Icon icon={CheckmarkCircle02Icon} size={11} />}
              {o.s === 'review' && <Icon icon={Clock01Icon} size={11} />}
              {o.s === 'blocked' && <Icon icon={Alert02Icon} size={11} />}
              {o.l}
            </span>
          </p>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ui-operate {
    width: 760px;
  }
  .op-stages {
    padding: 12px 16px 10px;
    border-bottom: 1px solid var(--ui-line);
  }
  .op-stage-track {
    display: grid;
    grid-template-columns: repeat(11, 1fr);
    gap: 3px;
  }
  .op-stage-track i {
    height: 4px;
    border-radius: 2px;
    background: var(--bg-sunken);
    transition: background-color 300ms;
  }
  .op-stage-track i.is-done {
    background: var(--primary);
  }
  .op-stage-track i.is-now {
    background: color-mix(in oklab, var(--primary) 45%, transparent);
  }
  .op-stage-label {
    display: flex;
    gap: 10px;
    margin-top: 8px !important;
    font-size: 11.5px;
  }
  .op-body {
    display: grid;
    grid-template-columns: 290px 1fr;
  }
  .op-doc {
    padding: 12px;
    background: var(--bg-sunken);
    border-right: 1px solid var(--ui-line);
  }
  .op-doc-file {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px !important;
    font-size: 11px;
    color: var(--ui-muted);
  }
  .op-paper {
    padding: 14px;
    border-radius: 4px;
    background: #fff;
    color: #1b2430;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 8px 20px -12px rgb(0 0 0 / 0.25);
    font-size: 11px;
  }
  .op-vendor {
    font-size: 13px;
    font-weight: 600;
    color: #0b4d7a;
  }
  .op-small {
    color: #6a7380;
    margin-bottom: 10px !important;
  }
  .op-fields p {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 6px;
    padding: 3px 0;
  }
  .op-fields span,
  .op-due span {
    color: #6a7380;
  }
  .op-fields b,
  .op-due b {
    font-weight: 500;
  }
  .op-charges {
    margin-top: 10px;
    padding-top: 6px;
    border-top: 1px solid #e3e7ec;
  }
  .op-charges p {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
  }
  .op-due {
    display: flex;
    justify-content: space-between;
    margin-top: 8px !important;
    padding-top: 8px;
    border-top: 1px solid #e3e7ec;
    font-size: 12px;
  }
  [data-op-field] {
    border-radius: 3px;
    transition:
      box-shadow 350ms,
      background-color 350ms;
  }
  [data-op-field].is-found {
    background: rgb(0 166 220 / 0.1);
    box-shadow: 0 0 0 2px rgb(0 166 220 / 0.55);
  }

  .op-lines {
    padding: 12px 16px 14px;
  }
  .op-section {
    font-size: 11px;
    color: var(--ui-muted);
    margin-bottom: 6px !important;
  }
  .op-tr {
    display: grid;
    grid-template-columns: 1.25fr 1fr 0.95fr 0.7fr;
    gap: 8px;
    align-items: start;
    padding: 7px 0;
    border-bottom: 1px solid var(--ui-line);
  }
  .op-th {
    font-size: 11px;
    color: var(--ui-muted);
  }
  .op-desc {
    line-height: 1.35;
  }
  .op-fill {
    display: grid;
    line-height: 1.3;
  }
  .op-fill em {
    font-style: normal;
    font-size: 10.5px;
  }
  .op-src {
    color: var(--primary);
  }
  .op-ready {
    position: relative;
    margin-top: 10px;
    height: 34px;
  }
  .op-ready > span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border-radius: 7px;
    font-weight: 500;
  }
  .op-ready-pending {
    color: var(--ui-muted);
    background: var(--bg-sunken);
  }
  .op-ready-done {
    color: var(--ui-up);
    background: color-mix(in oklab, var(--ui-up) 11%, transparent);
    opacity: 0;
  }
  .op-other {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    align-items: center;
    padding: 6px 0;
    border-top: 1px solid var(--ui-line);
  }
</style>
