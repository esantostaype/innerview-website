---
/**
 * Financials › Profit & Loss (proposed screen), Riverbend Flats, Sep 2026. Fictional figures that
 * reconcile: revenue − expenses = NOI ($214,602 vs $208,010 budget, +3.2%).
 */
import Icon from '../ui/Icon.astro';
import { ArrowDown01Icon, Download04Icon, Invoice01Icon, Calendar03Icon, Building03Icon } from '@hugeicons/core-free-icons';

type Row = { label: string; a: string; b: string; v: string; py: string; tone?: 'up' | 'down' | ''; kind?: 'head' | 'total' | 'noi'; id?: string };

const rows: Row[] = [
  { label: 'Revenue', a: '', b: '', v: '', py: '', kind: 'head' },
  { label: 'Gross potential rent', a: '452,160', b: '448,800', v: '+3,360', py: '431,520', tone: 'up' },
  { label: 'Loss to lease', a: '(9,840)', b: '(11,200)', v: '+1,360', py: '(8,610)', tone: 'up' },
  { label: 'Vacancy loss', a: '(27,130)', b: '(26,930)', v: '−200', py: '(31,240)', tone: 'down' },
  { label: 'Other income', a: '18,420', b: '17,500', v: '+920', py: '16,880', tone: 'up' },
  { label: 'Total revenue', a: '433,610', b: '428,170', v: '+5,440', py: '408,550', tone: 'up', kind: 'total' },
  { label: 'Operating expenses', a: '', b: '', v: '', py: '', kind: 'head' },
  { label: 'Payroll', a: '61,250', b: '62,000', v: '+750', py: '58,900', tone: 'up' },
  { label: 'Repairs & maintenance', a: '22,480', b: '19,500', v: '−2,980', py: '24,110', tone: 'down' },
  { label: 'Utilities', a: '41,330', b: '38,900', v: '−2,430', py: '39,870', tone: 'down', id: 'utilities' },
  { label: 'Management fees', a: '13,008', b: '12,845', v: '−163', py: '12,256', tone: 'down' },
  { label: 'Taxes & insurance', a: '80,940', b: '86,915', v: '+5,975', py: '79,300', tone: 'up' },
  { label: 'Total expenses', a: '219,008', b: '220,160', v: '+1,152', py: '214,436', tone: 'up', kind: 'total' },
  { label: 'Net operating income', a: '214,602', b: '208,010', v: '+6,592', py: '194,114', tone: 'up', kind: 'noi' },
];
---

<div class="ui ui-analyze" data-ui="analyze" aria-hidden="true">
  <div class="ui-bar">
    <span class="ui-title">Financials</span>
    <span class="ui-muted">/</span>
    <span>Profit &amp; Loss</span>
    <span class="ml-auto flex items-center gap-2">
      <span class="ui-chip"><Icon icon={Building03Icon} size={12} />Riverbend Flats<Icon icon={ArrowDown01Icon} size={11} /></span>
      <span class="ui-chip"><Icon icon={Calendar03Icon} size={12} />Sep 2026</span>
      <span class="ui-chip is-solid">vs Budget</span>
      <span class="ui-chip"><Icon icon={Download04Icon} size={12} />Export</span>
    </span>
  </div>
  <div class="ui-tabs">
    <span class="is-on">Profit &amp; Loss</span><span>Balance Sheet</span><span>Cash Flow</span><span>General Ledger</span>
  </div>

  <div class="pl">
    <p class="pl-row pl-th"><span>Account</span><span>Actual</span><span>Budget</span><span>Variance</span><span>Prior year</span></p>
    {
      rows.map((r) => (
        <p class:list={['pl-row', r.kind && `is-${r.kind}`]} data-pl-row={r.id}>
          <span class="pl-label">{r.label}</span>
          <span class="ui-num">{r.a}</span>
          <span class="ui-num ui-muted">{r.b}</span>
          <span class:list={['ui-num', r.tone === 'up' && 'ui-up', r.tone === 'down' && 'ui-down']}>{r.v}</span>
          <span class="ui-num ui-muted">{r.py}</span>
        </p>
      ))
    }
  </div>

  <!-- Drill-down: the invoices behind a variance -->
  <div class="ui-pop pl-pop" data-pl-pop>
    <p class="pl-pop-head">
      <span class="ui-title">Utilities · Sep 2026</span>
      <span class="ui-down">−2,430 vs budget</span>
    </p>
    <p class="pl-pop-row"><Icon icon={Invoice01Icon} size={13} class="ui-muted" /><span>Cumberland Power &amp; Light</span><span class="ui-num">18,240.55</span></p>
    <p class="pl-pop-row"><Icon icon={Invoice01Icon} size={13} class="ui-muted" /><span>Riverstone Water Utility</span><span class="ui-num">15,676.45</span></p>
    <p class="pl-pop-row"><Icon icon={Invoice01Icon} size={13} class="ui-muted" /><span>Volunteer Gas Service</span><span class="ui-num">7,413.00</span></p>
    <p class="pl-pop-foot ui-muted">3 posted invoices · GL 6510–6530</p>
  </div>
</div>

<style>
  .ui-analyze {
    width: 720px;
  }
  .pl {
    padding: 6px 8px 10px;
  }
  .pl-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 86px 86px 80px 86px;
    gap: 8px;
    align-items: center;
    padding: 6px 10px;
    border-radius: 6px;
    transition: background-color 300ms;
  }
  .pl-th {
    font-size: 11px;
    color: var(--ui-muted);
  }
  .pl-th span:not(:first-child) {
    text-align: right;
  }
  .pl-row.is-head {
    margin-top: 6px;
    font-size: 11px;
    font-weight: 500;
    color: var(--ui-muted);
  }
  .pl-row.is-total {
    font-weight: 500;
    border-top: 1px solid var(--ui-line);
    border-radius: 0;
  }
  .pl-row.is-noi {
    margin-top: 4px;
    font-weight: 600;
    background: color-mix(in oklab, var(--primary) 7%, transparent);
  }
  .pl-row:not(.is-head, .is-total, .is-noi, .pl-th) .pl-label {
    padding-left: 12px;
  }
  .pl-row.is-hot {
    background: color-mix(in oklab, var(--ui-down) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ui-down) 28%, transparent);
  }
  .pl-pop {
    left: 300px;
    top: 318px;
    width: 300px;
    padding: 12px 14px;
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transform-origin: 20% 0%;
  }
  .pl-pop-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px !important;
  }
  .pl-pop-row {
    display: grid;
    grid-template-columns: 16px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 5px 0;
    border-top: 1px solid var(--ui-line);
  }
  .pl-pop-foot {
    padding-top: 6px;
    font-size: 11px;
  }
</style>
