---
import Icon from './Icon.astro';
import { ArrowRight02Icon } from '@hugeicons/core-free-icons';

type IconNode = readonly (readonly [string, Record<string, string | number>])[];

interface Props {
  href: string;
  variant?: 'primary' | 'quiet' | 'inverse';
  size?: 'md' | 'lg';
  arrow?: boolean;
  icon?: IconNode;
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', arrow = false, icon, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, `btn-${size}`, className]} {...rest}>
  {icon && <Icon icon={icon} size={16} class="btn-lead" />}
  <span class="btn-label"><slot /></span>
  {
    arrow && (
      <span class="btn-arrow" aria-hidden="true">
        <Icon icon={ArrowRight02Icon} size={16} />
        <Icon icon={ArrowRight02Icon} size={16} />
      </span>
    )
  }
</a>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    border-radius: var(--radius-btn);
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    transition:
      background-color 280ms var(--ease-out-expo),
      box-shadow 280ms var(--ease-out-expo),
      color 280ms var(--ease-out-expo),
      transform 280ms var(--ease-out-expo);
  }
  .btn:active {
    transform: translateY(1px);
  }

  .btn-md {
    height: 2.375rem;
    padding-inline: 0.95rem;
    font-size: 0.875rem;
  }
  .btn-lg {
    height: 2.875rem;
    padding-inline: 1.25rem;
    font-size: 0.9375rem;
  }

  /* Primary: solid, inner top highlight, light sweep on hover */
  .btn-primary {
    background: var(--primary);
    color: var(--primary-fg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 1px 2px rgb(10 17 28 / 0.18),
      0 6px 16px -8px color-mix(in oklab, var(--primary) 70%, transparent);
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / 0.22) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform 700ms var(--ease-out-expo);
  }
  .btn-primary:hover {
    background: var(--primary-hover);
  }
  .btn-primary:hover::before {
    transform: translateX(120%);
  }

  /* Quiet: hairline, fills softly */
  .btn-quiet {
    color: var(--fg);
    background: color-mix(in oklab, var(--bg-raised) 60%, transparent);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }
  .btn-quiet:hover {
    background: var(--bg-raised);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--fg) 45%, var(--rule-strong)),
      0 4px 14px -8px rgb(10 17 28 / 0.25);
  }

  .btn-inverse {
    background: var(--ink-fg);
    color: var(--ink);
  }
  .btn-inverse:hover {
    background: #fff;
  }

  /* Arrow: two copies, the second slides in */
  .btn-arrow {
    position: relative;
    display: inline-grid;
    width: 16px;
    height: 16px;
    margin-right: -0.15rem;
    overflow: hidden;
  }
  .btn-arrow :global(svg) {
    grid-area: 1 / 1;
    transition: transform 460ms var(--ease-out-expo);
  }
  .btn-arrow :global(svg:last-child) {
    transform: translateX(-140%);
  }
  .btn:hover .btn-arrow :global(svg:first-child) {
    transform: translateX(140%);
  }
  .btn:hover .btn-arrow :global(svg:last-child) {
    transform: translateX(0);
  }

  .btn-lead {
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::before,
    .btn-arrow :global(svg) {
      transition: none !important;
    }
  }
</style>
